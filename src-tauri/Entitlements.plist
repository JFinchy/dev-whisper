<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Only takes effect under the hardened runtime, which notarization
  requires; there, an app without audio-input gets a silent microphone.
  Harmless with today's ad-hoc signing (hardenedRuntime is off).
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
